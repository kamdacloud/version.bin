#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <HTTPClient.h>   
#include <HTTPUpdate.h>   

// --- ตั้งค่า Fix IP ---
// IPAddress local_ip(192, 168, 1, 151);   // เปลี่ยนสำหรับแต่ละบอร์ด
// IPAddress gateway(192, 168, 1, 1);
// IPAddress subnet(255, 255, 255, 0);
// IPAddress primaryDNS(8, 8, 8, 8);

const char* ssid = "KAMDA.";
const char* password = "12345678";

// --- ตั้งค่า MQTT ---
const char* mqtt_server = "d5e2a19ac8614b0184643a016bcb97a7.s1.eu.hivemq.cloud"; 
const int mqtt_port = 8883; 
const char* mqtt_user = "admin";
const char* mqtt_pass = "12345678";
const char* mqtt_client_id = "ESP32_Control_Node1"; // เปลี่ยนเป็น Node 2 หากใช้กับบอร์ด 2

const int ledPins[4] = {12, 14, 27, 26}; 

// --- ตั้งค่า OTA Node 1 ---
String currentVersion = "1.1"; 
const char* version_url = "https://raw.githubusercontent.com/YourUser/YourRepo/main/node1_version.txt";
const char* firmware_url = "https://raw.githubusercontent.com/YourUser/YourRepo/main/node1_firmware.bin";

WiFiClientSecure espClient;
PubSubClient client(espClient);

void checkUpdate() {
  Serial.println("Starting OTA update check for Node 1...");
  WiFiClientSecure updateClient;
  updateClient.setInsecure(); 
  
  HTTPClient http;
  http.begin(updateClient, version_url);
  int httpCode = http.GET();
  
  if (httpCode == HTTP_CODE_OK) {
    String newVersion = http.getString();
    newVersion.trim(); 
    
    if (newVersion != currentVersion && newVersion.length() > 0) {
      Serial.println("New version found! Starting OTA update...");
      client.publish("farm/status/node1", "updating", true);
      
      t_httpUpdate_return ret = httpUpdate.update(updateClient, firmware_url);
      
      switch (ret) {
        case HTTP_UPDATE_FAILED:
          client.publish("farm/status/node1", "online", true); 
          break;
        case HTTP_UPDATE_NO_UPDATES:
          break;
        case HTTP_UPDATE_OK:
          break;
      }
    }
  }
  http.end();
}

void callback(char* topic, byte* payload, unsigned int length) {
  String message = "";
  for (int i = 0; i < length; i++) message += (char)payload[i];
  
  // 1. ควบคุมสวิตช์
  for (int i = 0; i < 4; i++) {
    String expectedTopic = String("farm/control/node1/led") + String(i + 1); // เปลี่ยน node1 เป็น node2 สำหรับบอร์ด 2
    if (String(topic) == expectedTopic) {
      if (message == "ON") digitalWrite(ledPins[i], HIGH);
      else if (message == "OFF") digitalWrite(ledPins[i], LOW);
    }
  }

  // 2. ดักจับคำสั่ง Force Update จากปุ่ม (ตรงโฟลเดอร์ให้เป็น node1 หรือ node2)
  if (String(topic) == "farm/control/node1/update") {
    if (message == "FORCE") {
      checkUpdate(); 
    }
  }
}

void reconnect() {
  while (!client.connected()) {
    if (client.connect(mqtt_client_id, mqtt_user, mqtt_pass, "farm/status/node1", 0, true, "offline")) {
      client.publish("farm/status/node1", "online", true);
      client.subscribe("farm/control/node1/#"); // ตรงนี้จะรับทั้งสวิตช์ไฟและคำสั่ง update
    } else {
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);
  for (int i = 0; i < 4; i++) {
    pinMode(ledPins[i], OUTPUT);
    digitalWrite(ledPins[i], LOW);
  }

  // WiFi.config(local_ip, gateway, subnet, primaryDNS);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) { delay(500); }

  espClient.setInsecure(); 
  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);
}

void loop() {
  if (!client.connected()) reconnect();
  client.loop(); 
}